[Unit]
Description=Restore rrgb keyboard & lightbar lighting on boot and resume
Documentation=https://github.com/MikhaelCat/r-rgb
After=basic.target multi-user.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'if [ -x /usr/local/bin/rrgb ]; then exec /usr/local/bin/rrgb restore --quiet --wait 10; elif [ -x /usr/bin/rrgb ]; then exec /usr/bin/rrgb restore --quiet --wait 10; fi'

[Install]
WantedBy=multi-user.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
