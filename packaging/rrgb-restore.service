[Unit]
Description=Restore rrgb keyboard & lightbar lighting on boot and resume
Documentation=https://github.com/MikhaelCat/r-rgb
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/rrgb restore --quiet --wait 10

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
